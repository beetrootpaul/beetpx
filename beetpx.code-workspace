{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascript]": {
      "editor.rulers": [80],
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[odin]": {
      "editor.rulers": [80],
    },
    "[shellscript]": {
      "editor.rulers": [80],
    },
    "files.exclude": {
      ".vscode": true,
      "**/.claude": true,
      "**/build": true
    }
  },
  "extensions": {
    "recommendations": ["danielgavin.ols"],
  },
}
